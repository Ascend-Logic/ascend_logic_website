{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "nextjs", "import", "jsx-a11y", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "commonjs": true
  },
  "rules": {
    "jsx-a11y/alt-text": ["warn", { "elements": ["img"], "img": ["Image"] }]
  }
}
